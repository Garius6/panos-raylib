экспорт функ нарисовать_текстурный_куб(текстура: Текстура2D, позиция: Вектор3, ширина: Число, высота: Число, глубина: Число, оттенок: Цвет) -> Пусто
    пер левая = позиция.x - ширина / 2.0
    пер правая = позиция.x + ширина / 2.0
    пер низ = позиция.y - высота / 2.0
    пер верх = позиция.y + высота / 2.0
    пер ближняя = позиция.z - глубина / 2.0
    пер дальняя = позиция.z + глубина / 2.0

    // RL_QUADS = 7. Координаты повторяются на каждой грани: небольшие
    // сегменты мира дают нужный тайлинг без новой C-зависимости.
    rlSetTexture(текстура.id)
    rlBegin(7)
    rlColor4ub(оттенок.r, оттенок.g, оттенок.b, оттенок.a)

    rlTexCoord2f(0.0, 1.0); rlVertex3f(левая, низ, дальняя)
    rlTexCoord2f(1.0, 1.0); rlVertex3f(правая, низ, дальняя)
    rlTexCoord2f(1.0, 0.0); rlVertex3f(правая, верх, дальняя)
    rlTexCoord2f(0.0, 0.0); rlVertex3f(левая, верх, дальняя)

    rlTexCoord2f(1.0, 1.0); rlVertex3f(левая, низ, ближняя)
    rlTexCoord2f(1.0, 0.0); rlVertex3f(левая, верх, ближняя)
    rlTexCoord2f(0.0, 0.0); rlVertex3f(правая, верх, ближняя)
    rlTexCoord2f(0.0, 1.0); rlVertex3f(правая, низ, ближняя)

    rlTexCoord2f(0.0, 0.0); rlVertex3f(левая, верх, ближняя)
    rlTexCoord2f(0.0, 1.0); rlVertex3f(левая, низ, ближняя)
    rlTexCoord2f(1.0, 1.0); rlVertex3f(левая, низ, дальняя)
    rlTexCoord2f(1.0, 0.0); rlVertex3f(левая, верх, дальняя)

    rlTexCoord2f(1.0, 0.0); rlVertex3f(правая, верх, ближняя)
    rlTexCoord2f(0.0, 0.0); rlVertex3f(правая, верх, дальняя)
    rlTexCoord2f(0.0, 1.0); rlVertex3f(правая, низ, дальняя)
    rlTexCoord2f(1.0, 1.0); rlVertex3f(правая, низ, ближняя)

    rlTexCoord2f(0.0, 1.0); rlVertex3f(левая, низ, ближняя)
    rlTexCoord2f(1.0, 1.0); rlVertex3f(правая, низ, ближняя)
    rlTexCoord2f(1.0, 0.0); rlVertex3f(правая, низ, дальняя)
    rlTexCoord2f(0.0, 0.0); rlVertex3f(левая, низ, дальняя)

    rlTexCoord2f(0.0, 0.0); rlVertex3f(левая, верх, дальняя)
    rlTexCoord2f(1.0, 0.0); rlVertex3f(правая, верх, дальняя)
    rlTexCoord2f(1.0, 1.0); rlVertex3f(правая, верх, ближняя)
    rlTexCoord2f(0.0, 1.0); rlVertex3f(левая, верх, ближняя)
    rlEnd()
    rlSetTexture(0)
конец

экспорт функ нарисовать_контур_куба(позиция: Вектор3, ширина: Число, высота: Число, глубина: Число, цвет: Цвет) -> Пусто
