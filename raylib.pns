// raylib для panos поверх динамического FFI (`внешний`/`ff_структура`)
// — обычная panos-библиотека, никакого host-кода на стороне panos core.
//
// Путь к библиотеке ЗАХАРДКОЖЕН на macOS/Apple Silicon + `brew install
// raylib` (`/opt/homebrew/opt/raylib/lib/libraylib.dylib`) — честно
// задокументированный, не скрытый пробел (см. README.md, "Известные
// ограничения"). Голое имя `"libraylib"` НЕ работает — raylib не лежит
// на стандартных путях поиска dyld/ld.so, в отличие от libc — нужен
// полный путь.
//
// C bool (WindowShouldClose/IsKeyDown) маршаллится как Целое(8) (тот же
// байтовый размер на этой платформе) — обёрточные функции ниже
// конвертируют 0/1 в настоящий Булево, чтобы panos-сторона не знала о
// деталях C ABI.

экспорт тип Вектор2 = ff_структура
    x: Число(32)
    y: Число(32)
конец

экспорт тип Прямоугольник = ff_структура
    x: Число(32)
    y: Число(32)
    ширина: Число(32)
    высота: Число(32)
конец

// Плоские представления Texture2D и RenderTexture2D. У RenderTexture2D
// развёрнуты два вложенных Texture: это сохраняет C ABI и даёт Panos
// возможность рисовать в буфер низкого разрешения.
экспорт тип Текстура2D = ff_структура
    id: Целое(32)
    ширина: Целое(32)
    высота: Целое(32)
    mipmaps: Целое(32)
    формат: Целое(32)
конец

экспорт тип РендерТекстура2D = ff_структура
    id: Целое(32)
    цвет_id: Целое(32)
    цвет_ширина: Целое(32)
    цвет_высота: Целое(32)
    цвет_mipmaps: Целое(32)
    цвет_формат: Целое(32)
    глубина_id: Целое(32)
    глубина_ширина: Целое(32)
    глубина_высота: Целое(32)
    глубина_mipmaps: Целое(32)
    глубина_формат: Целое(32)
конец

// Vector3 из raylib. Плоская структура из трёх f32 безопасно передаётся
// через текущий FFI Panos по значению.
экспорт тип Вектор3 = ff_структура
    x: Число(32)
    y: Число(32)
    z: Число(32)
конец

// В C Camera3D содержит три вложенных Vector3. Вложенные ff_структура пока
// намеренно не поддерживаются, поэтому здесь тот же 44-байтный layout
// раскрыт в плоские поля: 9 * f32 + f32 + i32.
экспорт тип Камера3D = ff_структура
    position_x: Число(32)
    position_y: Число(32)
    position_z: Число(32)
    target_x: Число(32)
    target_y: Число(32)
    target_z: Число(32)
    up_x: Число(32)
    up_y: Число(32)
    up_z: Число(32)
    fovy: Число(32)
    projection: Целое(32)
конец

экспорт тип Цвет = ff_структура
    r: Целое(8)
    g: Целое(8)
    b: Целое(8)
    a: Целое(8)
конец

внешний "/opt/homebrew/opt/raylib/lib/libraylib.dylib" функ InitWindow(ширина: Целое(32), высота: Целое(32), заголовок: КСтрока) -> Пусто
внешний "/opt/homebrew/opt/raylib/lib/libraylib.dylib" функ WindowShouldClose() -> Целое(8)
